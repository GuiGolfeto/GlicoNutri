# ─── Banco ───────────────────────────────────────────────────────────────────
# Desenvolvimento local (docker compose). Porta 5433 para nao colidir com um
# Postgres do sistema.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=gliconutri;Username=gliconutri;Password=gliconutri_dev

# Supabase. A string vem do painel em Project Settings > Database > Connection
# string. Projetos novos nao expoem conexao direta por IPv4: use o pooler.
#
#   Session mode  (porta 5432) — obrigatorio para rodar migrations
#   Transaction mode (porta 6543) — para a aplicacao em producao; exige
#                                   No Reset On Close=true e Max Auto Prepare=0
#
# ConnectionStrings__Default=Host=aws-0-<REGIAO>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<REF_DO_PROJETO>;Password=<SENHA_DO_BANCO>;SSL Mode=Require;Trust Server Certificate=true

# ─── JWT proprio da API (UC001, RN32) ────────────────────────────────────────
# Nao tem relacao com as chaves do Supabase: a autenticacao e da API, conforme
# a decisao de arquitetura registrada no README.
Jwt__Issuer=gliconutri-api
Jwt__Audience=gliconutri-clients
Jwt__SigningKey=troque-esta-chave-em-producao-com-no-minimo-32-bytes
Jwt__ExpiresHours=24

# ─── Envio de e-mail (RF10.2, RF10.3) ────────────────────────────────────────
# Enquanto Habilitado for false, o sistema apenas registra as mensagens no log
# da API — e as senhas provisorias aparecem la durante o desenvolvimento.
Email__Habilitado=false
# Email__Host=smtp.gmail.com
# Email__Porta=587
# Email__Usuario=<conta>
# Email__Senha=<senha de app>
# Email__Remetente=nao-responda@adj.org.br
# Email__RemetenteNome=GlicoNutri
# Email__UsarSslDireto=false
Email__UrlWeb=http://localhost:5173
