# Banco local (docker-compose). Porta 5433 para nao colidir com um Postgres do sistema.
ConnectionStrings__Default=Host=localhost;Port=5433;Database=gliconutri;Username=gliconutri;Password=gliconutri_dev

# Supabase — preencher quando o Mateus repassar as credenciais.
# ConnectionStrings__Default=Host=<PROJETO>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<SENHA>;SSL Mode=Require;Trust Server Certificate=true

# JWT — UC001 (validade de 24h) / RN32
Jwt__Issuer=gliconutri-api
Jwt__Audience=gliconutri-clients
Jwt__SigningKey=troque-esta-chave-em-producao-com-no-minimo-32-bytes
Jwt__ExpiresHours=24
